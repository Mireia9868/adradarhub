# Meta Ad Library official Graph API.
# Required for direct Meta live data.
META_ACCESS_TOKEN=
META_GRAPH_VERSION=v23.0
META_AD_LIBRARY_LIMIT=30
META_AD_ACTIVE_STATUS=ALL
META_AD_TYPE=ALL
META_SEARCH_TYPE=KEYWORD_UNORDERED

# Microsoft Advertising Ad Library official public API.
# Enabled by default. Set to false to disable direct Microsoft calls.
BING_AD_LIBRARY_DIRECT=true
BING_AD_LIBRARY_LIMIT=30
BING_AD_LIBRARY_BASE_URL=https://adlibrary.api.bingads.microsoft.com/api/v1/Ads
# Optional Microsoft country code filter. Leave blank for broad query.
BING_AD_LIBRARY_COUNTRY_CODES=

# Google Ads Transparency Center does not expose a documented public REST API.
# Configure a compliant internal connector that reads Google Transparency Center data.
GOOGLE_TRANSPARENCY_ENDPOINT=

# Optional generic connector endpoints. These override demo mode for their platform
# when direct mode is unavailable or disabled.
META_TRANSPARENCY_ENDPOINT=
BING_TRANSPARENCY_ENDPOINT=
TRANSPARENCY_CONNECTOR_TOKEN=
CONNECTOR_TIMEOUT_MS=15000
CONNECTOR_CURL_FALLBACK=true

# Qwen (通义) 图像生成密钥，来自 https://home.qwencloud.com/
# 密钥只需配置在服务端（Render 环境变量 / 本地 .env），切勿写入前端代码或提交到仓库。
QWEN_API_KEY=
# 可选：图像生成 API 基地址，默认 https://dashscope-intl.aliyuncs.com/api/v1
QWEN_API_BASE_URL=https://dashscope-intl.aliyuncs.com/api/v1
