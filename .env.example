# Meta Ad Library official Graph API.
# Required for direct Meta live data.
META_ACCESS_TOKEN=
META_GRAPH_VERSION=v23.0
META_AD_LIBRARY_LIMIT=30
META_AD_ACTIVE_STATUS=ALL
META_AD_TYPE=ALL
META_SEARCH_TYPE=KEYWORD_UNORDERED

# Microsoft Advertising Ad Library official public API.
# Enabled by default. Set to false to disable direct Microsoft calls.
BING_AD_LIBRARY_DIRECT=true
BING_AD_LIBRARY_LIMIT=24
BING_AD_LIBRARY_BASE_URL=https://adlibrary.api.bingads.microsoft.com/api/v1/Ads
# Optional Microsoft country code filter. Leave blank for broad query.
BING_AD_LIBRARY_COUNTRY_CODES=

# Google Ads Transparency Center does not expose a documented public REST API.
# Configure a compliant internal connector that reads Google Transparency Center data.
GOOGLE_TRANSPARENCY_ENDPOINT=

# Optional generic connector endpoints. These override demo mode for their platform
# when direct mode is unavailable or disabled.
META_TRANSPARENCY_ENDPOINT=
BING_TRANSPARENCY_ENDPOINT=
TRANSPARENCY_CONNECTOR_TOKEN=
CONNECTOR_TIMEOUT_MS=15000
CONNECTOR_CURL_FALLBACK=true

# Qwen (通义) 图像生成密钥，来自 https://home.qwencloud.com/
# 密钥只需配置在服务端（Render 环境变量 / 本地 .env），切勿写入前端代码或提交到仓库。
QWEN_API_KEY=
# 可选：图像生成 API 基地址，默认 https://dashscope-intl.aliyuncs.com/api/v1
QWEN_API_BASE_URL=https://dashscope-intl.aliyuncs.com/api/v1
# 外部生图代理端点（Cloudflare Worker 等）。配置后 /api/generate-image 优先走此端点，
# 返回内联 base64 图，浏览器直接渲染、不跳站外；密钥只存在 Worker 侧。
# 未配置时回退到上方内置 Qwen。
IMAGE_GEN_ENDPOINT=
# 可选：生图代理超时（毫秒），默认 90000
IMAGE_GEN_TIMEOUT_MS=90000

# YouTube Data API v3（竞品视频情报源）。
# Google Cloud Console 开通 YouTube Data API 后创建 API Key，密钥只配置在服务端，
# 切勿写入前端代码或提交仓库。每日免费配额 10,000 units：search.list 100/次，
# videos.list 1/次（50 个视频），默认配置约可支持每天数十次情报刷新。
YOUTUBE_API_KEY=
# 品牌关键词搜索返回的视频数（1-25），默认 15
YOUTUBE_SEARCH_LIMIT=15
# 可选：regionCode（如 US），留空为全球
YOUTUBE_REGION_CODE=
# 可选：结果语言偏好（如 en）
YOUTUBE_RELEVANCE_LANGUAGE=

# DeepSeek 文本生成密钥，来自 https://platform.deepseek.com/api_keys
# 仅用于非生图逻辑（总结、提示词、文案等）。密钥只需配置在服务端，切勿写入前端或提交仓库。
DEEPSEEK_API_KEY=
# 可选：API 基地址，默认 https://api.deepseek.com
DEEPSEEK_API_BASE_URL=https://api.deepseek.com

# YouTube 搜索相关性控制（可选）
# 精确短语搜索，默认 true；关闭后 YouTube 会模糊匹配，噪音明显增多
YOUTUBE_EXACT_PHRASE=true
# 搜索市场与语种，默认 US / en
YOUTUBE_REGION_CODE=US
YOUTUBE_RELEVANCE_LANGUAGE=en

# ===== TikTok 视频情报 =====
# 官方没有可对标的公开数据 API：Display API 只能读授权用户自己的视频；
# Research API 准入限定为美/欧非营利学术机构，商业团队不符合资格；
# Creative Center 匿名 JSON 接口 2026 年起已全部返回 no permission。
# 因此走第三方数据源 TikHub：https://user.tikhub.io 注册 → Dashboard 生成 API Key。
# 计费 $0.001/次起，注册送 $0.05 体验额度（约 50 次调用），支持支付宝 / PayPal。
# 密钥只配置在服务端，切勿写入前端代码或提交仓库。
TIKTOK_API_KEY=
# 数据源 provider，目前支持 tikhub
TIKTOK_PROVIDER=tikhub
# API 基地址：海外/服务器上用 https://api.tikhub.io；
# 中国大陆因主域名被墙，需改为 https://api.tikhub.dev（路径与参数完全一致）
TIKTOK_API_BASE_URL=https://api.tikhub.io
# 每次搜索返回的视频数（5-50），默认 20
TIKTOK_SEARCH_LIMIT=20
# 搜索地区（ISO 3166-1 alpha-2，如 US/GB/DE）。留空则取所选市场的第一个
TIKTOK_REGION=
# 搜索排序：0 = 综合相关度（默认，噪音最少）；1 = 最多点赞（会混入大量无关爆款）
TIKTOK_SORT_TYPE=0

# ===== 账号体系（Supabase）=====
# Supabase Project URL，形如 https://xxxxx.supabase.co（Project Settings → API）
SUPABASE_URL=
# service_role key（会绕过 RLS，只能放服务端，切勿进前端或仓库）
SUPABASE_SERVICE_ROLE_KEY=
# 会话签名密钥，用 openssl rand -hex 32 生成
AUTH_SECRET=
# 登录后每天可拉取的次数，默认 10
DAILY_QUOTA=10
# 配额切日的时区偏移（小时），默认 8 = 北京时间每日 0 点重置
QUOTA_UTC_OFFSET=8
